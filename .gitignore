# Local-only working material (todo, notes, the paper, the EVM reference) — not pushed.
/others/

# Rust build output (any `target/` at any depth: contracts/target, fuzz target, …)
target/
**/*.rs.bk
Cargo.lock.orig
.DS_Store

# cargo-fuzz generated outputs
**/fuzz/corpus/
