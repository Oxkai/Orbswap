# soroban test snapshots (auto-written by the test env)
**/test_snapshots/

# local deployment secrets / config — NEVER commit (.env.example is the template)
.env
.env.*
!.env.example

# optimized wasm artifacts (rebuilt by the deploy scripts)
**/*.optimized.wasm
