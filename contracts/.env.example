# Orbswap deployment config — copy to `.env` and edit. Every value has a default,
# so the deploy scripts work with NO .env at all. `.env` is gitignored; never commit
# a file that contains a secret key.
#
#   cp .env.example .env
#   bash scripts/deploy_testnet.sh      # single pool + 2 test tokens + smoke swap
#   bash scripts/deploy_all.sh          # pool wasm → factory → router → pool → swap

# Network passphrase / RPC alias the stellar-cli knows. Use `testnet` or `mainnet`
# (mainnet also needs a real, funded key — friendbot funding is testnet-only).
STELLAR_NETWORK=testnet

# Name of the stellar-cli identity used as the deployer/source. If it does not
# exist the script generates + friendbot-funds it (testnet only). To use your own:
#   stellar keys add my-deployer --secret-key   # paste your S... key
# then set DEPLOYER_IDENTITY=my-deployer here. The secret stays in the stellar-cli
# keystore, NOT in this file.
DEPLOYER_IDENTITY=orbswap

# Swap fee for the pool the scripts create, in basis points (30 = 0.30%). 0..10000.
POOL_FEE_BPS=30

# Space-separated asset codes → pool size (2..8). n>2 is deployed as a SuperElliptical
# pool (Circular is 2-token only). deploy_testnet.sh honors this; deploy_all.sh (factory)
# is 2-token only and ignores extra codes.
TOKEN_CODES="USDA USDB USDC USDD"
