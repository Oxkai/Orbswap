# Orbswap deployment config — copy to `.env` and edit. Every value has a default,
# so the deploy scripts work with NO .env at all. `.env` is gitignored; never commit
# a file that contains a secret key.
#
#   cp .env.example .env
#   bash scripts/deploy_pipeline.sh     # full pipeline: periphery → pools → seed → sim
#
# For the mainnet runbook (RPC setup, funding, preflight) see docs/MAINNET.md.

# Network the stellar-cli knows: `testnet` or `mainnet`. Mainnet needs a real,
# funded key — friendbot funding is testnet-only — and an RPC URL configured:
#   stellar network add mainnet --rpc-url <url> \
#     --network-passphrase 'Public Global Stellar Network ; September 2015'
STELLAR_NETWORK=testnet

# Name of the stellar-cli identity used as the deployer/source. If it does not
# exist the script generates + friendbot-funds it (testnet only). To use your own:
#   stellar keys add my-deployer --secret-key   # paste your S... key
# then set DEPLOYER_IDENTITY=my-deployer here. The secret stays in the stellar-cli
# keystore, NOT in this file.
#
# Do NOT reuse a testnet-generated key on mainnet — generate a dedicated one.
DEPLOYER_IDENTITY=my-wallet

# Issues the mock SAC tokens on testnet. Unused on mainnet, where the pipeline
# binds to the real issuers compiled into the script.
TOKEN_ISSUER_IDENTITY=orbswap-issuer

# Swap fee for both pools, in basis points (30 = 0.30%). 0..10000.
POOL_FEE_BPS=30

# How many randomised swaps stage 8 runs. SWAPS=0 skips the simulation entirely —
# useful for a cheap first mainnet pass that only proves the deploy sequence.
SWAPS=18

# Minimum XLM the mainnet preflight requires in the deployer account before it
# will spend anything. ~156 XLM of fees + 3.5 locked in reserves, plus headroom.
REQUIRED_XLM=220

# ── Escape hatches (mainnet preflight) ────────────────────────────────────────
# DRY_RUN=1      run preflight and stop before any spend
# CONFIRM="DEPLOY MAINNET"  skip the interactive typed confirmation (CI)
# ALLOW_SHORT=1  proceed even if token balances/trustlines are short (NOT advised:
#                the uploads are paid at stage 3 and cannot be refunded if
#                seeding then fails at stage 7)
